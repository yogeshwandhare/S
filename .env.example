# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the resulting .env file.

# --- General ---
ENVIRONMENT=production
# Set true only for local development bootstrap. Must be false in any
# deployment reachable by anyone other than you.
ALLOW_DEV_BOOTSTRAP=false

# --- PostgreSQL ---
POSTGRES_USER=smartvision
POSTGRES_PASSWORD=changeme-use-a-long-random-value
POSTGRES_DB=smartvision

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-real-64-byte-secret

# Comma-separated list of origins the browser is allowed to call the API
# from. In the default docker-compose setup the frontend and API share an
# origin (http://localhost:8080) via Caddy, so this rarely needs changing.
CORS_ORIGINS=http://localhost:8080

# Public URL operators/users are told to visit -- used to build links in
# notification emails. Change this to your real domain in production.
PUBLIC_BASE_URL=http://localhost:8080

# --- SMTP (optional) ---
# If left blank, email notifications are skipped and marked
# SKIPPED_NOT_CONFIGURED; in-app notifications and everything else in the
# app continue to work normally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Vision worker (added in Milestone 2) ---
# auto | cpu | cuda -- "auto" detects a CUDA GPU if present and falls back
# to CPU otherwise. Never assumes GPU availability.
INFERENCE_DEVICE=auto
